* {
    primary: #80d4d5;
    primary-fixed: #9cf1f2;
    primary-fixed-dim: #80d4d5;
    on-primary: #003737;
    on-primary-fixed: #002020;
    on-primary-fixed-variant: #004f50;
    primary-container: #004f50;
    on-primary-container: #9cf1f2;
    secondary: #b0cccb;
    secondary-fixed: #cce8e8;
    secondary-fixed-dim: #b0cccb;
    on-secondary: #1b3435;
    on-secondary-fixed: #041f20;
    on-secondary-fixed-variant: #324b4b;
    secondary-container: #324b4b;
    on-secondary-container: #cce8e8;
    tertiary: #b3c8e9;
    tertiary-fixed: #d4e3ff;
    tertiary-fixed-dim: #b3c8e9;
    on-tertiary: #1d314b;
    on-tertiary-fixed: #051c35;
    on-tertiary-fixed-variant: #344863;
    tertiary-container: #344863;
    on-tertiary-container: #d4e3ff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0e1514;
    on-surface: #dde4e3;
    on-surface-variant: #bec8c8;
    outline: #899392;
    outline-variant: #3f4948;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dde4e3;
    inverse-on-surface: #2b3231;
    inverse-primary: #00696b;
    surface-dim: #0e1514;
    surface-bright: #343a3a;
    surface-container-lowest: #090f0f;
    surface-container-low: #161d1d;
    surface-container: #1a2121;
    surface-container-high: #252b2b;
    surface-container-highest: #2f3636;
    base00: #172127;
    base00CC: #172127CC;
    base01: #283238;
    base02: #394349;
    base03: #4a545a;
    base04: #5b656a;
    base05: #6c757b;
    base06: #7d868c;
    base07: #8e979d;
    base08: #3d586b;
    base09: #2a4155;
    base0A: #576f7f;
    base0B: #364d5c;
    base0C: #273e49;
    base0D: #2f4651;
    base0E: #24373f;
    base0F: #2e4047;

    /* Alpha-baked surface colors — matches waybar's matchsurface approach */
    match-surface:             #0E151499;
    match-surface-high:        #252B2B99;
    match-surface-low:         #161D1D99;
    match-outline:             #3F494899;
    match-primary:             #80D4D599;

}

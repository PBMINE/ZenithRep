// -*- mode: jsonc -*-
{
    "height": 25,
    "margin": "0 0 7 0",
    "spacing": 15,
    "position": "bottom",
    "reload_style_on_change": true,
    "modules-left": [],

    "group/center": {
        "orientation": "horizontal",
        "modules": ["hyprland/window", "hyprland/workspaces", "group/traydrawer","group/hardware","hyprland/language","pulseaudio", "network","bluetooth","clock","power-profiles-daemon","battery","custom/swaync" ]
    },

    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false,
            "click-to-reveal": true,
        },
        "modules": ["custom/hardware-wrap", "cpu", "memory", "temperature"]
    },

    "custom/hardware-wrap": {
        "format": "󰚗",
        "tooltip-format": "Hardware and etc"
    },

    "group/traydrawer": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false,
            "click-to-reveal": true,
        },
        "modules": [ "custom/tray-wrap", "tray" ],
    },

    "custom/tray-wrap": {
        "format": "",
        "tooltip-format": "Background application (tray)"
    },

    "modules-center": [ "group/center" ],

    "modules-right": [],

    "tray": {
        "icon-size": 12,
        "spacing": 12
    },

    /*"clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },*/

    "clock": {
        "format": "{:%A %H:%M}",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "first-day-of-week": 1,
            "format": {
                "today": "<u><b>{}</b></u>",
                "weeks": "<span color='#888888'><i>W{}</i></span>"
            },
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },


    "cpu": {
        "format": "{usage}%  󰍛",
        "tooltip": false
    },

    "memory": {
        "format": "{}%  󰍜"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": [" 󱃃"]
    },

    "battery": {
        "states": {
            "warning": 20,
            "critical": 5
        },
    	"events": {
            "on-discharging-warning": "notify-send -u normal -i battery-low -t 5000 -c device 'Low Battery!' 'You may plug-in your charger soon.'",
            "on-discharging-critical": "notify-send -u critical -t 0 'Very Low Battery!' 'Goodluck, The system will shutdown.'"
        },
        "format": "{icon} ",
        "format-full": "{icon} ",
        "format-charging":" {icon} ",
        "format-plugged": "󰚥 {icon} ",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "You're battery is at {capacity}%, It will last for {time}"
    },

    "power-profiles-daemon": {
        "format": " {icon}  ",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        }
    },

    "network": {
        "rfkill": true,
        "format-wifi": "{icon}",
        "format-disabled": "󰤮",
        "tooltip-format-disabled": "No network connection existed yet :(",
        "format-icons": ["󰤮", "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "",
        "tooltip-format": "{essid}",
        "tooltip-format-ethernet": "{gwaddr} ",
        "format-linked": "",
        "format-disconnected": "󰤮",
        "interval": 5,
        "on-click": "networkmanager_dmenu"
    },

    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "  {icon} {format_source}",
        "format-muted": "  {format_source}",
        "format-source": "{volume}% 󰍬 ",
        "format-source-muted": " 󰍭",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format": "   ",
        "format-disabled": "  󰂲 ",
        "format-connected": "   ",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "rofi-bluetooth"
    },

    "custom/swaync": {
        "format": "   ",
        "tooltip-format": "Notfication Center",
        "on-click": "swaync-client -t"
    },


    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-th": "TH",
        "on-click": "hyprctl switchxkblayout all next"
    },

    "hyprland/workspaces": {
        "all-outputs": true,
        "format": " {name} ",
        "active-only": false,
        "on-click": "hyprctl dispatch workspace {name}",
        "persistent-workspaces": {
            "*": 9,
        },
    },

    "hyprland/window": {
        "max-length": 40,
        "max-chars": 40,
        "fallback": "No window",
        "separate-outputs": true
    }
}
